# Smart Cloud Shield (SCS) Environment Configuration
# Copy this file to .env to customize settings. All values are optional for local development.

SECRET_KEY=change-me-to-a-secure-random-key
# SCS_KEK=<Fernet key>   # Master KEK; generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# =====================================================================
# Email & Security Notification Pipeline (SMTP)
# =====================================================================
# When MAIL_SERVER is omitted, SCS runs in Dev Simulation Mode (dispatches to console & admin outbox viewer).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-specific-password
# MAIL_FROM=Smart Cloud Shield Security <security@smartcloudshield.local>
# ADMIN_ALERT_EMAIL=admin@yourcompany.com
# SHOW_OTP=0            # Set to 0 to hide on-screen dev OTP code once real email is configured

# =====================================================================
# Generative AI & Threat Intelligence (Google Gemini API)
# =====================================================================
# Get your free key at: https://aistudio.google.com/app/apikey
# When omitted, SCS automatically uses the built-in Intelligent Local Threat Synthesizer without failing.
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# =====================================================================
# General Platform & Storage
# =====================================================================
# TZ_OFFSET_MIN=330     # Timezone offset in minutes (e.g. 330 for IST +05:30)
# STORAGE_BACKEND=local # 'local' or 's3'
# S3_BUCKET=your-bucket-name
# DEMO_MODE=0
